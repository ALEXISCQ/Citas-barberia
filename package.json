{
  "name": "citas-barberia",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 3001",
    "dev:frontend": "npm run dev --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}